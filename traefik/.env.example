# Traefik Configuration
TRAEFIK_ENABLE=false
CERT_RESOLVER=staging
HOST=traefik.docker.localhost
PORT=8080

# TLS Configuration
HOST_SANS=*.docker.localhost

# Authentication Configuration
TRUEAUTH_DOMAIN=auth.docker.localhost
TRUEAUTH_COOKIE=_auth

# IMPORTANT: Do not put real credentials here. Prefer encrypted secrets (see docs/secrets.md).
# Example placeholder only: generate with `htpasswd -nb <user> <password>`
# For local dev you may keep a dummy value; for Swarm, inject via a decrypted env at deploy time.
SSO_CREDENTIALS='admin:$apr1$replace_me$examplehash'
