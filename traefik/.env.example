# Traefik Configuration
TRAEFIK_ENABLE=true
CERT_RESOLVER=letsencrypt
HOST=traefik.example.com
PORT=8080

# TLS Configuration
HOST_SANS=*.example.com

# Authentication Configuration
TRUEAUTH_DOMAIN=auth.example.com
TRUEAUTH_COOKIE=_auth
SSO_CREDENTIALS=admin:$apr1$xyz...  # Generate using htpasswd -nb admin your_password 