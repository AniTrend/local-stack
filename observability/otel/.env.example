# Traefik Configuration for OpenTelemetry HTTP endpoints
TRAEFIK_ENABLE=false
CERT_RESOLVER=letsencrypt
HOST=otel.docker.localhost
PORT=4318  # OTLP HTTP endpoint that Traefik will route to

# Direct Ports (not routed through Traefik)
OTLP_GRPC_PORT=4317      # For direct gRPC connections
METRICS_PORT=8888        # Internal metrics
PROM_METRICS_PORT=8889   # Prometheus exporter metrics
HEALTH_CHECK_PORT=13133  # Health check endpoint
