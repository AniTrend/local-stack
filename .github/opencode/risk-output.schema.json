{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AniTrend/local-stack/.github/opencode/risk-output.schema.json",
  "title": "OpenCode Renovate Risk Review Output",
  "description": "Schema for the OpenCode risk classifier output in the Renovate gate workflow.",
  "type": "object",
  "required": [
    "schema_version",
    "decision",
    "risk",
    "automerge_allowed",
    "dependency_ecosystem",
    "update_type",
    "summary",
    "confidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "local-stack.dependabot-risk.v1"
    },
    "decision": {
      "type": "string",
      "enum": ["approve", "changes_requested", "neutral"]
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high", "unknown"]
    },
    "automerge_allowed": {
      "type": "boolean"
    },
    "dependency_ecosystem": {
      "type": "string",
      "enum": ["docker", "github-actions", "mixed", "unknown"]
    },
    "update_type": {
      "type": "string",
      "enum": ["semver-patch", "semver-minor", "semver-major", "digest", "non-semver", "unknown"]
    },
    "changed_images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "from", "to", "risk_reason"],
        "properties": {
          "name": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "risk_reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "changed_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "breaking_change_assessment": {
      "type": "string"
    },
    "runtime_impact": {
      "type": "string"
    },
    "required_checks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "manual_follow_up": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sources_checked": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    }
  },
  "additionalProperties": false
}
