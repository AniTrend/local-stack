{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "^\\.github/actions/setup-stackctl/action\\.yml$"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-releases) depName=(?<depName>[^\\s]+) versioning=(?<versioning>semver-coerced)\\s+default:\\s*['\"](?<currentValue>v[^'\"]+)['\"]"
      ]
    }
  ],
  "addLabels": [
    ":dagger: dependencies"
  ],
  "branchPrefix": "deps/",
  "reviewers": [
    "wax911"
  ],
  "baseBranchPatterns": [
    "dev"
  ],
  "autoApprove": false,
  "automerge": false,
  "automergeType": "pr",
  "automergeStrategy": "rebase"
}
