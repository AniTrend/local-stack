# Traefik Configuration
TRAEFIK_ENABLE=false
CERT_RESOLVER=staging
HOST=dashboard.apisix.docker.localhost
PORT=9000

# Logging
LOG_LEVEL=warn  # Options: debug, info, warn, error, panic, fatal

# Authentication
AUTHENTICATION_SECRET=change-this-secret-in-production
AUTH_EXPIRE_TIME=3600
USER_PRIMARY_NAME=admin
USER_PRIMARY_PASSWORD=admin
USER_SECONDARY_NAME=viewer
USER_SECONDARY_PASSWORD=viewer

# Service Information
SERVICE_VERSION=1.0.0

# OpenTelemetry Configuration
OPEN_TELEMETRY_COLLECTOR=http://otel-collector:4318

# Loki Configuration
LOKI_HOST=http://loki
LOKI_PORT=3100

# Security
ENABLE_SSL=false
CORS_ALLOW_ORIGINS=*

# Metrics
PROMETHEUS_PORT=9091 