# Timezone
TZ=Africa/Johannesburg

# Webhook secret (for GitHub webhook validation)
# Generate: openssl rand -hex 32
# Place the secret in doco-cd/secrets/webhook_secret
## WEBHOOK_SECRET is set via WEBHOOK_SECRET_FILE in the compose file

# API secret (for Doco-CD REST API)
# Generate: openssl rand -hex 32
# Place the secret in doco-cd/secrets/api_secret
## API_SECRET is set via API_SECRET_FILE in the compose file

# Poll config is defined inline in docker-compose.yml via POLL_CONFIG.
# For file-based config, mount a file and set POLL_CONFIG_FILE.
