FROM ubuntu@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac

ENV DEBIAN_FRONTEND=noninteractive

RUN rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get update \
    && apt-get --download-only install --no-install-recommends --yes \
       ca-certificates python3 python3-apt sudo systemd-timesyncd tar tzdata \
       util-linux e2fsprogs iptables \
    && apt-get install --no-install-recommends --yes python3 python3-apt
