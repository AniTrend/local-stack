# Traefik Configuration
TRAEFIK_ENABLE=false
CERT_RESOLVER=letsencrypt
DASHBOARD_HOST=dashboard.growthbook.docker.localhost
DASHBOARD_PORT=3000
DASHBOARD_API_HOST=api.growthbook.docker.localhost
API_PORT=3100

# MongoDB Configuration
MONGODB_URI=mongodb://mongo:27017/growthbook

# Security
JWT_SECRET=your_secure_jwt_secret
ENCRYPTION_KEY=your_32_char_encryption_key

# Email Configuration (optional)
EMAIL_ENABLED=false
EMAIL_HOST=smtp.docker.localhost
EMAIL_PORT=587
EMAIL_USER=your_email@docker.localhost
EMAIL_PASSWORD=your_email_password

# OTEL Configuration
GROWTHBOOK_OTEL_ENABLE_LOGS_COLLECTION=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=growthbook