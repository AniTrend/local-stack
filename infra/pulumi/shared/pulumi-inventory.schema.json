{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anitrend:platform:pulumi-inventory:v1",
  "title": "AniTrend HCloud Pulumi inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "stack_identity",
    "provider",
    "resource_ids",
    "network_ids",
    "firewall_ids",
    "firewall_policy",
    "hosts",
    "volumes",
    "architecture",
    "image_ref",
    "native_execution",
    "budget_limit_eur",
    "estimated_monthly_cost_eur",
    "cost_estimate_ref",
    "ttl_hours",
    "readiness"
  ],
  "properties": {
    "schema_version": { "const": "anitrend.platform.pulumi-inventory.v1" },
    "environment": { "enum": ["rehearsal", "production"] },
    "stack_identity": { "type": "string", "minLength": 1 },
    "provider": { "const": "hcloud" },
    "resource_ids": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logical_id", "provider_id", "kind"],
        "properties": {
          "logical_id": { "type": "string", "minLength": 1 },
          "provider_id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["server", "network", "subnet", "firewall", "server_network", "volume", "volume_attachment", "dns_rrset"] }
        }
      }
    },
    "network_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "firewall_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "firewall_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ssh_source_cidrs", "public_routes", "private_routes"],
      "properties": {
        "ssh_source_cidrs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "public_routes": { "$ref": "#/$defs/routes" },
        "private_routes": { "$ref": "#/$defs/routes" }
      }
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_id",
          "name",
          "bootstrap_user",
          "public_ipv4",
          "public_ipv6",
          "private_addresses",
          "region",
          "server_type",
          "architecture",
          "os_image",
          "ssh_key_refs",
          "expected_host_identity_ref"
        ],
        "properties": {
          "resource_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "bootstrap_user": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,31}$" },
          "public_ipv4": { "type": ["string", "null"], "format": "ipv4" },
          "public_ipv6": { "type": ["string", "null"], "format": "ipv6" },
          "private_addresses": { "type": "array", "items": { "type": "string", "format": "ipv4" } },
          "region": { "type": "string", "minLength": 1 },
          "server_type": { "type": "string", "minLength": 1 },
          "architecture": { "enum": ["amd64", "arm64"] },
          "os_image": { "type": "string", "minLength": 1 },
          "ssh_key_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "expected_host_identity_ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    "volumes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource_id", "reference", "linux_device", "filesystem", "mount_path", "size_gb", "data_classification", "protected"],
        "properties": {
          "resource_id": { "type": "string", "minLength": 1 },
          "reference": { "type": "string", "minLength": 1 },
          "linux_device": { "type": "string", "minLength": 1 },
          "filesystem": { "const": "ext4" },
          "mount_path": { "type": "string", "pattern": "^/[^\\s]*$" },
          "size_gb": { "type": "integer", "minimum": 1 },
          "data_classification": { "type": "string", "minLength": 1 },
          "protected": { "type": "boolean" }
        }
      }
    },
    "architecture": { "enum": ["amd64", "arm64"] },
    "image_ref": { "type": "string", "minLength": 1 },
    "native_execution": { "const": true },
    "budget_limit_eur": { "type": "number", "exclusiveMinimum": 0 },
    "estimated_monthly_cost_eur": { "type": "number", "exclusiveMinimum": 0 },
    "cost_estimate_ref": { "type": "string", "minLength": 1 },
    "ttl_hours": { "type": ["integer", "null"], "minimum": 1 },
    "readiness": { "enum": ["ready", "blocked", "failed"] }
  },
  "$defs": {
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hostname", "service_ref", "port", "protocol", "source_cidrs"],
        "properties": {
          "hostname": { "type": "string", "minLength": 1 },
          "service_ref": { "type": "string", "minLength": 1 },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "protocol": { "enum": ["http", "https", "tcp", "udp"] },
          "source_cidrs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
