{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anitrend:platform:environment-intent:v1",
  "title": "Resolved AniTrend cloud environment intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "provider",
    "project_ref",
    "region",
    "server_type",
    "architecture",
    "os_image",
    "network_cidrs",
    "volumes",
    "ssh_key_refs",
    "bootstrap_user",
    "ssh_source_cidrs",
    "public_routes",
    "private_routes",
    "dns_provider_ref",
    "dns_zone_ref",
    "dns_records",
    "private_hostnames",
    "certificate_strategy_ref",
    "tailnet_grants_ref",
    "state_backend_ref",
    "backup_destination_ref",
    "backup_retention_days",
    "credential_refs",
    "recovery_credential_refs",
    "rpo_hours",
    "rto_minutes",
    "maintenance_window_ref",
    "maximum_downtime_minutes",
    "rollback_thresholds",
    "writer_job_map_ref",
    "source_host_identity_ref",
    "target_host_identity_ref",
    "deployment_owner_map_ref",
    "deployment_freeze_steps_ref",
    "service_dependency_map_ref",
    "database_runtime_facts_ref",
    "gateway_policy_export_ref",
    "external_provider_map_ref",
    "backup_restore_matrix_ref",
    "budget_limit_eur",
    "estimated_monthly_cost_eur",
    "cost_estimate_ref",
    "ttl_hours",
    "allowed_docker_contexts",
    "safety_policy"
  ],
  "properties": {
    "schema_version": { "const": "anitrend.platform.environment-intent.v1" },
    "environment": { "enum": ["rehearsal", "production"] },
    "provider": { "const": "hcloud" },
    "project_ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
    "region": { "type": "string", "minLength": 1 },
    "server_type": { "type": "string", "minLength": 1 },
    "architecture": { "enum": ["amd64", "arm64"] },
    "os_image": { "type": "string", "minLength": 1 },
    "network_cidrs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "cidr", "subnet_cidr", "purpose"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
          "cidr": { "type": "string", "minLength": 1 },
          "subnet_cidr": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 }
        }
      }
    },
    "volumes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id_ref", "size_gb", "mount_path", "data_classification", "protected"],
        "properties": {
          "id_ref": { "type": "string", "minLength": 1 },
          "size_gb": { "type": "integer", "minimum": 10, "maximum": 10000 },
          "mount_path": { "type": "string", "pattern": "^/[^\\s]*$" },
          "data_classification": { "type": "string", "minLength": 1 },
          "protected": { "type": "boolean" }
        }
      }
    },
    "ssh_key_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" } },
    "bootstrap_user": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,31}$" },
    "ssh_source_cidrs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "public_routes": { "$ref": "#/$defs/routes" },
    "private_routes": { "$ref": "#/$defs/routes" },
    "dns_provider_ref": { "type": ["string", "null"] },
    "dns_zone_ref": { "type": ["string", "null"] },
    "dns_records": { "$ref": "#/$defs/dnsRecords" },
    "private_hostnames": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "certificate_strategy_ref": { "type": ["string", "null"] },
    "tailnet_grants_ref": { "type": ["string", "null"] },
    "state_backend_ref": { "type": "string", "pattern": "^pulumi-cloud:[A-Za-z0-9][A-Za-z0-9._/-]*$" },
    "backup_destination_ref": { "type": "string", "minLength": 1 },
    "backup_retention_days": { "type": "integer", "minimum": 1 },
    "credential_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "recovery_credential_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "rpo_hours": { "type": "integer", "minimum": 0 },
    "rto_minutes": { "type": "integer", "minimum": 1 },
    "maintenance_window_ref": { "type": "string", "minLength": 1 },
    "maximum_downtime_minutes": { "type": "integer", "minimum": 1 },
    "rollback_thresholds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "writer_job_map_ref": { "type": "string", "minLength": 1 },
    "source_host_identity_ref": { "type": "string", "minLength": 1 },
    "target_host_identity_ref": { "type": "string", "minLength": 1 },
    "deployment_owner_map_ref": { "type": "string", "minLength": 1 },
    "deployment_freeze_steps_ref": { "type": "string", "minLength": 1 },
    "service_dependency_map_ref": { "type": "string", "minLength": 1 },
    "database_runtime_facts_ref": { "type": "string", "minLength": 1 },
    "gateway_policy_export_ref": { "type": "string", "minLength": 1 },
    "external_provider_map_ref": { "type": "string", "minLength": 1 },
    "backup_restore_matrix_ref": { "type": "string", "minLength": 1 },
    "budget_limit_eur": { "type": "number", "exclusiveMinimum": 0 },
    "estimated_monthly_cost_eur": { "type": "number", "exclusiveMinimum": 0 },
    "cost_estimate_ref": { "type": "string", "minLength": 1 },
    "ttl_hours": { "type": ["integer", "null"], "minimum": 1 },
    "allowed_docker_contexts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "safety_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protect_resources", "allow_destroy", "require_environment_approval", "deny_pull_request_mutations"],
      "properties": {
        "protect_resources": { "type": "boolean" },
        "allow_destroy": { "type": "boolean" },
        "require_environment_approval": { "type": "boolean" },
        "deny_pull_request_mutations": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "environment": { "const": "production" } }, "required": ["environment"] },
      "then": {
        "type": "object",
        "properties": {
          "ttl_hours": { "type": "null" },
          "safety_policy": {
            "type": "object",
            "properties": {
              "protect_resources": { "const": true },
              "allow_destroy": { "const": false },
              "require_environment_approval": { "const": true },
              "deny_pull_request_mutations": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": { "type": "object", "properties": { "environment": { "const": "rehearsal" } }, "required": ["environment"] },
      "then": {
        "type": "object",
        "properties": {
          "ttl_hours": { "type": "integer", "minimum": 1 },
          "safety_policy": {
            "type": "object",
            "properties": {
              "allow_destroy": { "const": true },
              "require_environment_approval": { "const": true },
              "deny_pull_request_mutations": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": { "type": "object", "properties": { "dns_records": { "type": "array", "minItems": 1 } }, "required": ["dns_records"] },
      "then": {
        "type": "object",
        "properties": {
          "dns_provider_ref": { "type": "string", "minLength": 1 },
          "dns_zone_ref": { "type": "string", "minLength": 1 }
        }
      }
    }
  ],
  "$defs": {
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hostname", "service_ref", "port", "protocol", "source_cidrs"],
        "properties": {
          "hostname": { "type": "string", "minLength": 1 },
          "service_ref": { "type": "string", "minLength": 1 },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "protocol": { "enum": ["http", "https", "tcp", "udp"] },
          "source_cidrs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "dnsRecords": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hostname", "record_type", "target_ref", "ttl_seconds"],
        "properties": {
          "hostname": { "type": "string", "minLength": 1 },
          "record_type": { "enum": ["A", "AAAA", "CNAME"] },
          "target_ref": { "type": "string", "minLength": 1 },
          "ttl_seconds": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
