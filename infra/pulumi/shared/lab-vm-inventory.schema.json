{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anitrend:platform:pulumi-inventory:lab-v1",
  "title": "AniTrend lab VM inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "stack_identity",
    "provider",
    "ssh_source_cidrs",
    "hosts",
    "volumes",
    "architecture",
    "image_ref",
    "native_execution",
    "readiness"
  ],
  "properties": {
    "schema_version": { "const": "anitrend.platform.pulumi-inventory.lab-v1" },
    "environment": { "const": "lab" },
    "stack_identity": { "type": "string", "minLength": 1 },
    "provider": { "const": "external-vm" },
    "ssh_source_cidrs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/host" }
    },
    "volumes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/volume" }
    },
    "architecture": { "enum": ["amd64", "arm64"] },
    "image_ref": { "type": "string", "minLength": 1 },
    "native_execution": { "const": true },
    "readiness": { "enum": ["ready", "blocked", "failed"] }
  },
  "$defs": {
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "name",
        "bootstrap_user",
        "connect_address",
        "architecture",
        "os_image",
        "expected_host_identity_ref"
      ],
      "properties": {
        "resource_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "bootstrap_user": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,31}$" },
        "connect_address": {
          "oneOf": [
            { "type": "string", "format": "ipv4" },
            { "type": "string", "format": "ipv6" }
          ]
        },
        "architecture": { "enum": ["amd64", "arm64"] },
        "os_image": { "type": "string", "minLength": 1 },
        "expected_host_identity_ref": { "type": "string", "minLength": 1 }
      }
    },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "reference",
        "linux_device",
        "filesystem",
        "format_policy",
        "mount_path",
        "size_gb",
        "data_classification",
        "protected"
      ],
      "properties": {
        "resource_id": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 },
        "linux_device": { "type": "string", "pattern": "^/dev/disk/by-id/[^\\s]+$" },
        "filesystem": { "const": "ext4" },
        "format_policy": { "enum": ["never", "create-only"] },
        "mount_path": { "type": "string", "pattern": "^/(?:srv|mnt|var/lib)/[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*$" },
        "size_gb": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "data_classification": { "type": "string", "minLength": 1 },
        "protected": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "format_policy": { "const": "create-only" } },
            "required": ["format_policy"]
          },
          "then": {
            "properties": { "data_classification": { "const": "empty" } }
          }
        }
      ]
    }
  }
}